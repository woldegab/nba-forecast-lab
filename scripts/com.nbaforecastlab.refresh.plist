<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/mac_refresh.sh every day at 8:30 a.m. local time. If the Mac is asleep
     then, macOS runs it once when it wakes. REPO_PATH is filled in by the install command. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nbaforecastlab.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>REPO_PATH/scripts/mac_refresh.sh &gt;&gt; "$HOME/Library/Logs/nba-forecast-lab.log" 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
</dict>
</plist>
